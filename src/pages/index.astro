---
import Layout from '@/layouts/main.astro';
import Hero from '@/components/sections/Hero.astro';
import Purpose from '@/components/sections/Purpose.astro';
import Steps from '@/components/sections/Steps.astro';
import Benefits from '@/components/sections/Benefits.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Try from '@/components/sections/Try.astro';
import FAQ from '@/components/sections/FAQ.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

import data from '@/data/data.json';
---

<Layout
  lang={data.site.lang}
  title={data.site.title}
  description={data.site.description}
  canonical={data.site.url}
>
  <div class="header-hero-wrapper">
    <Header />
    <Hero data={data.hero} />
  </div>

  <main class="flex-1">
    <Purpose data={data.purpose} />
    <Steps data={data.steps} />
    <Benefits data={data.benefits} />
    <Reviews data={data.reviews} />
    <Try data={data.try} />
    <FAQ data={data.faq} />
  </main>

  <Footer />
</Layout>
