---
import { cn } from '@/lib/utils';
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'button'> {
  class?: string;
}

const { class: className, type = 'button', ...rest } = Astro.props;
---

<button
  type={type}
  class={cn(
    'w-full text-center px-4 py-3.75 rounded-full text-lg bg-[#005ee8] text-white font-poppins font-semibold truncate hover:bg-[#0041c4] active:bg-[#003399] transition-all disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#005ee8]',
    className
  )}
  {...rest}
>
  <slot />
</button>
