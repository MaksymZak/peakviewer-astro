---
import SliderButton from '@/components/SliderButton.astro';
import Button from '../Button.astro';

interface Props {
  data: {
    id: string;
    title: string;
    text: string;
    list: Array<{
      icon: string;
      title: string;
      text: string;
    }>;
    btnText: string;
  };
}

const {
  data: { title, text, list, btnText },
} = Astro.props;
---

<section class="section benefits overflow-hidden">
  <div class="container">
    <h2
      class="section-title text-center text-[#2d3035] xl:mx-auto xl:max-w-191.75"
      set:html={title}
    />

    <p class="mt-5 text-center text-base leading-normal text-[#7A798C] xl:mx-auto xl:max-w-145">
      {text}
    </p>

    <div class="swiper-container relative mt-6 md:-mx-8 xl:-mx-5 xl:mt-8">
      <div class="swiper-wrapper">
        {
          list.map(item => (
            <div class="swiper-slide flex! h-auto! flex-col rounded-[24px] bg-[#f6f6f9] p-4 xl:p-8">
              <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-[#CAD8FF]">
                <img
                  src={`./images/sections/benefits/${item.icon}.svg`}
                  loading="lazy"
                  width="32"
                  height="32"
                  alt="decorative icon"
                />
              </div>
              <h4 class="mt-6 text-center text-2xl leading-[1.4] font-semibold text-[#05012C] xl:mt-8">
                {item.title}
              </h4>
              <p class="mt-3 text-center text-base leading-normal text-[#3C3A4F]">
                {item.text}
              </p>{' '}
            </div>
          ))
        }
      </div>

      <div class="mt-6 flex items-center justify-center gap-2">
        <SliderButton class="button-prev" direction="left" />
        <SliderButton class="button-next" direction="right" />
      </div>

      <Button class="mt-6 xl:mx-auto xl:mt-8 xl:block xl:w-auto xl:min-w-46">{btnText}</Button>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Navigation } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';

  new Swiper('.benefits .swiper-container', {
    navigation: {
      nextEl: '.benefits .button-next',
      prevEl: '.benefits .button-prev',
    },
    centeredSlides: true,
    initialSlide: 1,
    grabCursor: true,
    speed: 500,
    slidesPerView: 'auto',
    spaceBetween: 16,
    modules: [Navigation],
    breakpoints: {
      768: {
        slidesPerView: 1,
        width: 389,
      },
      1200: {
        slidesPerView: 1,
        width: 389,
        centeredSlides: true,
      },
    },
  });
</script>
